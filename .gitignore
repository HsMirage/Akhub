# ---------------------------------------------------------------- 构建产物
/target
/dist
web/node_modules
web/dist
web/tsconfig.tsbuildinfo

# ---------------------------------------------------------- 运行时数据目录
# SQLite、主密钥与临时文件都在这里。
/data

# ------------------------------------------------ 内部文档（不随仓库发布）
# 规划、审查与偏差核对记录只在本机保留：公开仓库里不该混进这些过程材料。
/计划.md
/计划.md.bak
/规划文档符合度检查报告.md
/*_功能审查-Akhub-report.md
/诊断报告-*.md
/review

# ------------------------------------------------------------ 桌面端（desktop/）
# 独立 crate：构建产物必须留在 desktop/target，不碰仓库根的 /target（服务端在用）。
/desktop/target
# Tauri CLI 的 npm 依赖。
/desktop/node_modules
# sidecar 二进制由 desktop/prepare-sidecar.sh 从服务端构建产物复制而来：约 20 MB，
# 且每个平台一份，不进版本库（CI 与本地都在构建前生成）。
/desktop/binaries/*
!/desktop/binaries/.gitkeep
# Tauri 每次构建都会重新生成的 ACL 清单与 JSON schema。
/desktop/gen/schemas

# ---------------------------------------------------------------- 本地文件
# 浏览器自动化快照与本地编辑器/代理配置。
/.playwright-mcp
/.claude
.DS_Store
